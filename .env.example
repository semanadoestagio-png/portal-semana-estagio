# Copie este arquivo para .env.local e preencha com os dados do projeto "teste" do Supabase.
# Onde achar: painel do Supabase > Project Settings > API Keys / Data API.
# O .env.local nunca vai para o git.

# Endereço do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública ("publishable key", começa com sb_publishable_). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta ("secret key", começa com sb_secret_). SÓ no servidor. Ainda não é usada na Fase 0.
SUPABASE_SECRET_KEY=
